{
  "name": "@konitif/physics",
  "version": "0.285.2",
  "private": false,
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "Headless physics backend lifecycle, commands and observations with explicit providers.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeMouf/konitif-physics.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE.md",
    "tsconfig.json",
    "reference"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
